# Куда публикуем: sftp (рекомендуется) или ftp.
DEPLOY_PROTOCOL=ftp

# Хост и порт из панели хостинга. Это может быть домен или IP сервера.
DEPLOY_HOST=hyperborea-legends.ru
DEPLOY_PORT=22

DEPLOY_USER=zakharau_hyperborea1
DEPLOY_PASSWORD=qige1L8930%

# Вместо пароля можно указать SSH-ключ (только для SFTP).
# DEPLOY_KEY_PATH=C:\Users\Fabol\.ssh\id_ed25519
# DEPLOY_KEY_PASSPHRASE=

# Каталог сайта (document root) на хостинге.
# Чаще всего /public_html или /www/hyperborea-legends.ru/public_html.
DEPLOY_REMOTE_DIR=/hyperborea-lagends/public_html

# FTP с TLS (обычно не требуется).
# DEPLOY_FTP_SECURE=true
