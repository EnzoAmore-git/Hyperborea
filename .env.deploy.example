# Public template only. Keep passwords and keys in ignored .env.deploy.
# Copy to .env.deploy and fill the LOCAL copy; never fill this tracked file.
DEPLOY_PROTOCOL=sftp
DEPLOY_HOST=example.beget.tech
DEPLOY_PORT=22
DEPLOY_USER=your-account
DEPLOY_PASSWORD=
DEPLOY_KEY_PATH=
DEPLOY_KEY_PASSPHRASE=
DEPLOY_REMOTE_DIR=/home/your-account/site/public_html
DEPLOY_SITE_URL=https://example.com
DEPLOY_FTP_SECURE=false
